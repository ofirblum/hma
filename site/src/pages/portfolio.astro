---
import SpatialPortfolio from '../components/SpatialPortfolio.astro';
import NimbusFont from '../components/NimbusFont.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5ced9" />
    <link rel="preload" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/assets/portfolio/Board.svg`} as="fetch" crossorigin />
    <title>Portfolio | High Mountains Archive</title>
    <NimbusFont />
  </head>
  <body>
    <SpatialPortfolio />
  </body>
</html>