---
const href = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/fonts/NimbusSans-Bold.otf`;
const css = `@font-face{font-family:'Nimbus Sans';src:url('${href}') format('opentype');font-weight:700;font-style:normal;font-display:swap}`;
---
<link rel="preload" href={href} as="font" type="font/otf" crossorigin />
<style is:inline set:html={css}></style>
