---
interface Props { still: string; masterExtension: string; alt: string; class?: string; }
const { still, masterExtension, alt, class: className } = Astro.props;
const works = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/assets/works`;
---
<picture class={className}>
  <source srcset={`${works}/${still}.avif`} type="image/avif" />
  <source srcset={`${works}/${still}.webp`} type="image/webp" />
  <img src={`${works}/${still}.${masterExtension}`} alt={alt} decoding="async" />
</picture>